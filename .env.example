# Make a private working copy as .env for your own installation.
# OPENAI_API_KEY belongs in the deployed Worker's server-side secrets when enabling Cedar.
OPENAI_API_KEY=
# Optional remote publication, using your own HTTPS site and its independent write secret.
NEWS_STATION_URL=
EDITION_PUBLISH_TOKEN=
# If the destination is a private ChatGPT Site, the job also needs valid Sites service access.
SITES_ACCESS_TOKEN=
